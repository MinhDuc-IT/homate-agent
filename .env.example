POSTGRES_DB=homate
POSTGRES_USER=homate
POSTGRES_PASSWORD=homate_local
POSTGRES_PORT=55433
DATABASE_URL=postgresql+psycopg://homate:homate_local@localhost:55433/homate
APP_ENV=development
JWT_SECRET=homate-development-change-this-secret-before-production
WEATHER_API_KEY=

# Text agent provider; API keys stay server-side.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openai/gpt-4o-mini

# Local development; Docker uses its internal speech-service address.
STT_URL=http://127.0.0.1:9020
TTS_URL=http://127.0.0.1:9020

# Local RAG (Docker supplies internal addresses).
RAG_URL=http://127.0.0.1:9030
RAG_DB_PASSWORD=homate_rag_local
RAG_DATABASE_URL=postgresql://homate_rag:homate_rag_local@127.0.0.1:55433/homate
MODEL_CACHE=.work/rag-models
KNOWLEDGE_DIRECTORY=.work/knowledge
